HardsigmoidFwdOp:
  ref_api: "torch.nn.functional.hardsigmoid"
  family: elementwise
  status: implemented

  torch_compile_fullgraph: true
  signature:
    inputs:
      input: {dtype: "float16 | bfloat16 | float32"}
    outputs:
      output: {dtype: "same_as(input)"}
    params:
      inplace: {type: bool, default: false}
    shape_rules:
      - "output.shape == input.shape"

  workloads:
    # Smoke: small flat vector
    - {input_shape: [1048576], dtypes: [float32, float16, bfloat16], label: "smoke-1m"}
    # Full: SE-block gating (GPU manifest mbv3-se-gate)
    - {input_shape: [32, 240, 1, 1], dtypes: [float16, bfloat16], label: "mbv3-se-gate"}
    - {input_shape: [32, 960, 1, 1], dtypes: [float16, bfloat16], label: "mbv3-se-gate-deep"}
    # Full: large FC layer
    - {input_shape: [2048, 4096], dtypes: [float16, bfloat16], label: "fc-wide"}

  roofline:
    vars:
      N: "product(input.shape)"
    # FLOPs: hardsigmoid(x) = relu6(x + 3) / 6.
    # add(1) + two-sided-clamp(1, per convention) + div(1) = 3 per elem.
    flops: "3 * N"
    bytes: "2 * N * elem_bytes"

  source:
    kernel: tileops/kernels/elementwise/hardsigmoid/hardsigmoid.py
    kernel_map:
      hardsigmoid: HardsigmoidFwdKernel
    op: tileops/ops/elementwise/hardsigmoid.py
    test: tests/ops/test_hardsigmoid.py
    bench: benchmarks/ops/bench_hardsigmoid.py
    bench_manifest_driven: true

