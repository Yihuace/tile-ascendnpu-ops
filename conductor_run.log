import json, datetime
lines = open('examples/hardsigmoid/full.json').read().split('\n', 1)
data = json.loads(lines[1])
info = data['info']
created = info['time']['created']
updated = info['time']['updated']
total = (updated - created)/1000
def t(ms): return datetime.datetime.fromtimestamp(ms/1000).strftime('%H:%M:%S')
print('created', t(created), 'updated', t(updated), 'total_s', round(total,1))
# stage boundaries from dispatch->result
stages = [
 ('Stage 0 脚手架', 1791810146745, 1791811256182),
 ('gate0+migration init', 1791811256182, 1791811292645),
 ('Stage 1 设计(首次)', 1791811319974, 1791812329334),
 ('Stage 1 门禁修复', 1791812354847, 1791812413767),
 ('Stage 2 检视(首次)', 1791812423711, 1791812899753),
 ('Stage 1 设计修订', 1791812921104, 1791813584546),
 ('Stage 2 复检', 1791813590051, 1791814065414),
 ('Stage 3 开发', 1791814079993, 1791815031003),
 ('二次校验精度', 1791815033798, 1791815088137),
 ('Stage 5 集成', 1791815098164, 1791816601546),
]
for name, s, e in stages:
    d = (e-s)/1000
    print(f'{name:24s} {t(s)} -> {t(e)}  {d:8.1f}s  {d/total*100:5.1f}%')
