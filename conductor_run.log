import json
lines = open('examples/hardsigmoid/full.json').read().split('\n', 1)
data = json.loads(lines[1])
msgs = data['messages']
# Build list of (ts, description) for task dispatches and their completions
tasks = []
for i, m in enumerate(msgs):
    info = m.get('info', {})
    role = info.get('role')
    ts = info.get('time', {}).get('created')
    for p in m.get('parts', []):
        if isinstance(p, dict) and p.get('type') == 'tool' and p.get('tool') == 'task':
            inp = p.get('state', {}).get('input', {})
            desc = inp.get('description','')
            # task dispatch
            tasks.append((ts, 'DISPATCH', desc, i))
        elif isinstance(p, dict) and p.get('type') == 'tool' and p.get('tool') == 'task':
            pass
# Find tool results (task completion) - the assistant message that contains the task result
# Actually results come back as tool results in subsequent assistant messages
for i, m in enumerate(msgs):
    info = m.get('info', {})
    role = info.get('role')
    ts = info.get('time', {}).get('created')
    for p in m.get('parts', []):
        if isinstance(p, dict) and p.get('type') == 'tool' and p.get('tool') == 'task':
            st = p.get('state', {})
            if 'output' in st or 'result' in st or st.get('status') == 'completed':
                tasks.append((ts, 'RESULT', p.get('callID',''), i))

# Just print the task dispatch messages and their timestamps
print('Task dispatch timeline:')
for i, m in enumerate(msgs):
    info = m.get('info', {})
    ts = info.get('time', {}).get('created')
    for p in m.get('parts', []):
        if isinstance(p, dict) and p.get('type') == 'tool' and p.get('tool') == 'task':
            inp = p.get('state', {}).get('input', {})
            desc = inp.get('description','')
            print(f'  msg{i:3d} ts={ts} DISPATCH {desc}')
