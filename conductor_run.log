import json
lines = open('examples/hardsigmoid/full.json').read().split('\n', 1)
data = json.loads(lines[1])
msgs = data['messages']
for i, m in enumerate(msgs):
    info = m.get('info', {})
    role = info.get('role')
    t = info.get('time', {})
    created = t.get('created')
    # extract text from parts
    texts = []
    for p in m.get('parts', []):
        if isinstance(p, dict):
            if p.get('type') == 'text':
                texts.append(p.get('text','')[:80])
            elif p.get('type') == 'tool':
                texts.append('[tool:'+p.get('tool','')+'] '+str(p.get('state',{}).get('input',{}))[:80])
    summary = ' | '.join(texts)[:150]
    print(f'{i:3d} role={role} ts={created} :: {summary}')
