+/// Cast src to dst via an **f32** intermediate: cast src to f32, then f32 to
+/// dst.  Mirrors castSrcToF16ToDst above (same tensor/buffer handling), but
+/// the intermediate is f32 because the source is an integer type -- going
+/// through f16 would lose the integer range before narrowing to half.
+/// Both hops must be HW-supported casts.
+static LogicalResult castSrcToF32ToDst(hivm::VCastOp &op,
+                                       PatternRewriter &rewriter) {
+  auto tmpVCastOp =
+      castTo(rewriter, op.getLoc(), op.getSingleSrc(), op.getRoundModeAttr(),
+             Float32Type::get(op.getContext()));
+
+  TypeRange dstTypeRange;
+  if (op.hasPureTensorSemantics()) {
+    dstTypeRange = TypeRange(op.getResult());
+  }
+  Value srcF32 = op.hasPureTensorSemantics() ? tmpVCastOp->getResult(0)
+                                             : tmpVCastOp.getSingleDst();
+
+  hivm::VCastOp castF32ToDst = rewriter.create<hivm::VCastOp>(
+      op.getLoc(), dstTypeRange, srcF32, op.getSingleDst(),
+      op.getRoundModeAttr(), op.getCastAttr(), op.getTransposeAttr(),
+      op.getBroadcastAttr());
+
+  rewriter.replaceOp(op, castF32ToDst);
+  return success();
+}
