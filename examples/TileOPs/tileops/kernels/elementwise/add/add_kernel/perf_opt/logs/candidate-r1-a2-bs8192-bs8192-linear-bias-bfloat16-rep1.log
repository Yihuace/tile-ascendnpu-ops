                if out_dtype != compute_dtype:
                    T.vcast(a32, y_ub, round_mode="rint")
                else:
                    T.copy(a32, y_ub)

                # 5. Store UB -> GM (only valid elements copied out).
                T.copy(y_ub[0:tail_size], y[offset : offset + tail_size])

